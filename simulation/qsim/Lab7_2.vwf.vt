end 

lab7_2_vlg_sample_tst tb_sample (
	.clk(clk),
	.load_addr(load_addr),
	.load_data(load_data),
	.load_enable(load_enable),
	.load_matrix(load_matrix),
	.result_addr(result_addr),
	.rst(rst),
	.start_calc(start_calc),
	.sampler_tx(sampler)
);

lab7_2_vlg_check_tst tb_out(
	.calc_done(calc_done),
	.error(error),
	.result_data(result_data),
	.result_valid(result_valid),
	.sampler_rx(sampler)
);
