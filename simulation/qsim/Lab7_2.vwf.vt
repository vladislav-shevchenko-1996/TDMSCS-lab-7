module lab7_2_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg [7:0] load_addr;
reg [7:0] load_data;
reg load_enable;
reg load_matrix;
reg [7:0] result_addr;
reg rst;
reg start_calc;
// wires                                               
wire calc_done;
wire error;
wire [15:0] result_data;
wire result_valid;

wire sampler;                             

// assign statements (if any)                          
lab7_2 i1 (
// port map - connection between master ports and signals/registers   
	.calc_done(calc_done),
	.clk(clk),
	.error(error),
	.load_addr(load_addr),
	.load_data(load_data),
	.load_enable(load_enable),
	.load_matrix(load_matrix),
	.result_addr(result_addr),
	.result_data(result_data),
	.result_valid(result_valid),
	.rst(rst),
	.start_calc(start_calc)
);

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 
// load_addr[ 7 ]
initial
begin
	load_addr[7] = 1'b0;
end 
// load_addr[ 6 ]
initial
begin
	load_addr[6] = 1'b0;
end 
// load_addr[ 5 ]
initial
begin
	load_addr[5] = 1'b0;
end 
// load_addr[ 4 ]
initial
begin
	load_addr[4] = 1'b0;
end 
// load_addr[ 3 ]
initial
begin
	load_addr[3] = 1'b0;
	load_addr[3] = #180000 1'b1;
	load_addr[3] = #20000 1'b0;
end 
// load_addr[ 2 ]
initial
begin
	load_addr[2] = 1'b0;
	load_addr[2] = #100000 1'b1;
	load_addr[2] = #80000 1'b0;
end 
// load_addr[ 1 ]
initial
begin
	load_addr[1] = 1'b0;
	load_addr[1] = #60000 1'b1;
	load_addr[1] = #40000 1'b0;
	load_addr[1] = #40000 1'b1;
	load_addr[1] = #40000 1'b0;
	load_addr[1] = #60000 1'b1;
	load_addr[1] = #20000 1'b0;
end 
// load_addr[ 0 ]
initial
begin
	load_addr[0] = 1'b0;
	load_addr[0] = #40000 1'b1;
	# 20000;
	repeat(3)
	begin
		load_addr[0] = 1'b0;
		load_addr[0] = #20000 1'b1;
		# 20000;
	end
	load_addr[0] = 1'b0;
	load_addr[0] = #40000 1'b1;
	load_addr[0] = #20000 1'b0;
end 
// load_data[ 7 ]
initial
begin
	load_data[7] = 1'b0;
end 
// load_data[ 6 ]
initial
begin
	load_data[6] = 1'b0;
end 
// load_data[ 5 ]
initial
begin
	load_data[5] = 1'b0;
end 
// load_data[ 4 ]
initial
begin
	load_data[4] = 1'b0;
end 
// load_data[ 3 ]
initial
begin
	load_data[3] = 1'b0;
	load_data[3] = #160000 1'b1;
	load_data[3] = #40000 1'b0;
end 
// load_data[ 2 ]
initial
begin
	load_data[2] = 1'b0;
	load_data[2] = #80000 1'b1;
	load_data[2] = #80000 1'b0;
	load_data[2] = #40000 1'b1;
	load_data[2] = #60000 1'b0;
end 
// load_data[ 1 ]
initial
begin
	load_data[1] = 1'b0;
	load_data[1] = #40000 1'b1;
	load_data[1] = #40000 1'b0;
	load_data[1] = #40000 1'b1;
	load_data[1] = #40000 1'b0;
	load_data[1] = #80000 1'b1;
	load_data[1] = #20000 1'b0;
end 
// load_data[ 0 ]
initial
begin
	load_data[0] = 1'b0;
	# 20000;
	repeat(4)
	begin
		load_data[0] = 1'b1;
		load_data[0] = #20000 1'b0;
		# 20000;
	end
	load_data[0] = 1'b1;
	load_data[0] = #20000 1'b0;
	load_data[0] = #20000 1'b1;
	load_data[0] = #20000 1'b0;
end 

// load_enable
initial
begin
	load_enable = 1'b0;
	load_enable = #20000 1'b1;
	load_enable = #240000 1'b0;
end 

// load_matrix
initial
begin
