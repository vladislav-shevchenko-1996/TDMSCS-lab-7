`timescale 1 ps/ 1 ps
module lab7_2_vlg_sample_tst(
	clk,
	load_addr,
	load_data,
	load_enable,
	load_matrix,
	result_addr,
	rst,
	start_calc,
	sampler_tx
);
input  clk;
input [7:0] load_addr;
input [7:0] load_data;
input  load_enable;
input  load_matrix;
input [7:0] result_addr;
input  rst;
input  start_calc;
output sampler_tx;

reg sample;
time current_time;
always @(clk or load_addr or load_data or load_enable or load_matrix or result_addr or rst or start_calc)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
    if ($realtime == 0 || $realtime != current_time)  
    begin                                             
        if (sample === 1'bx)                          
            sample = 0;                               
        else                                          
            sample = ~sample;                         
    end                                               
    current_time = $realtime;                         
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

